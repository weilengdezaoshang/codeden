{
  "name": "codeden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs tsconfig.build.json --eval-evidence",
    "build:agent": "node scripts/build.mjs apps/agent",
    "test:packaging": "pnpm build && node scripts/verify-packages.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node --conditions=codeden-source --import tsx apps/eval-platform/src/cli/eval-command.ts",
    "run:eval": "node scripts/start-eval-platform.mjs",
    "eval:web": "node scripts/start-eval-platform.mjs",
    "agent": "node --conditions=codeden-source --import tsx apps/agent/src/agent-command.ts",
    "swebench:dev": "node scripts/start-swebench.mjs",
    "swebench:prepare": "node scripts/prepare-swebench-environment.mjs",
    "codeden": "node --conditions=codeden-source --import tsx src/cli/codeden.ts",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weilengdezaoshang/codeden.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/weilengdezaoshang/codeden/issues"
  },
  "homepage": "https://github.com/weilengdezaoshang/codeden#readme",
  "description": "",
  "devDependencies": {
    "@codeden/agent": "workspace:*",
    "@codeden/eval-platform": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "openai": "5.23.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
