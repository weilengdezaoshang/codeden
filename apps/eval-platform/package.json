{
  "name": "@codeden/eval-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "codeden-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*/*.js": {
      "codeden-source": "./src/*/*.ts",
      "types": "./dist/*/*.d.ts",
      "default": "./dist/*/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs . --eval-evidence",
    "typecheck": "tsc -b",
    "migrate": "node --conditions=codeden-source --import tsx src/platform/migrate-entry.ts",
    "worker": "node --conditions=codeden-source --import tsx src/platform/worker-entry.ts"
  },
  "dependencies": {
    "@codeden/core": "workspace:*",
    "@codeden/agent-runtime": "workspace:*",
    "@codeden/telemetry": "workspace:*",
    "@codeden/eval-engine": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "pg-boss": "12.28.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  },
  "bin": {
    "codeden-eval": "./bin/codeden-eval.mjs"
  }
}
