{
  "name": "@codeden/agent-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "codeden-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@codeden/core": "workspace:*",
    "openai": "5.23.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
